{
  "name": "stage-agent",
  "version": "1.0.0",
  "description": "Node.js LangGraph staging order agent with fake APIs and synthetic data",
  "main": "dist/server/app.js",
  "scripts": {
    "agent": "tsx src/index.ts",
    "ui": "tsx src/server/app.ts",
    "ui:stop": "kill-port 3000",
    "ui:fresh": "npm run ui:stop && npm run ui",
    "rag:demo": "tsx src/rag/demo.ts",
    "rag:eval": "tsx src/rag/eval.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
